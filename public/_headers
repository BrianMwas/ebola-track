# Cloudflare response headers (Workers static assets and Pages read this file).

/*
  # Private preview: keep it out of search engines (see PUBLIC_LAUNCH_BLOCKED in the README).
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The app checks this on every load to find the current snapshot; never cache it.
/data/latest.json
  Cache-Control: no-store

# Hashed by Next, or versioned by name (vendor), so they never change in place.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
